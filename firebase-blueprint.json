  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Administrator RBAC registry keyed by Firebase UID."
    },
    "/orders/{orderId}": {
      "schema": "OrderSummary",
      "description": "Operational summary of retail and wholesale orders."
    },
    "/orders/{orderId}/items/{itemId}": {
      "schema": "OrderLineItem",
      "description": "Product SKU line items belonging to an order."
    },
    "/orders/{orderId}/private_details/{detailId}": {
      "schema": "OrderPrivateDetails",
      "description": "Strictly isolated customer/dealer contact and shipping PII."
    },
    "/dealers/{dealerId}": {
      "schema": "DealerSummary",
      "description": "Dealer onboarding application and approval status directory shared with Flutter mobile app."
    },
    "/dealers/{dealerId}/application_details/{detailId}": {
      "schema": "DealerApplicationReviewDetails",
      "description": "Strictly isolated dealer applicant contact and warehouse review details."
    },
    "/service_requests/{requestId}": {
      "schema": "ServiceRequest",
      "description": "Water purifier installation, maintenance, and repair service desk tickets."
    },
    "/service_requests/{requestId}/private_details/{detailId}": {
      "schema": "ServiceRequestPrivateContact",
      "description": "Strictly isolated customer service site address and phone PII."
    },
    "/service_schedules/{scheduleId}": {
      "schema": "ServiceScheduleConfig",
      "description": "Configured technician time-slot availability queried by Mobile Screen 23."
    },
    "/notifications/{notificationId}": {
      "schema": "UserNotification",
      "description": "Trusted backend order and service event notifications read and marked-as-read on Mobile Screen 25."
    },
    "/users/{userId}/fcm_tokens/{deviceId}": {
      "schema": "DevicePushToken",
      "description": "Strictly owner-isolated FCM device registration tokens for Mobile Screen 25."
    },
    "/users/{userId}/delivery_addresses/{addressId}": {
      "schema": "UserDeliveryAddress",
      "description": "Strictly owner-isolated customer delivery addresses and unverified map pin coordinates for Mobile Screen 26."
    },
    "/razorpay_orders/{razorpayOrderId}": {
      "schema": "RazorpayOrderBinding",
      "description": "Server-only Razorpay order binding registry (denied to all client SDKs)."
    },
    "/payment_settlements/{paymentId}": {
      "schema": "PaymentSettlementRecord",
      "description": "Server-only Razorpay payment settlement idempotency ledger (denied to all client SDKs)."
    },
    "/payment_webhook_events/{eventId}": {
      "schema": "PaymentWebhookEventRecord",
      "description": "Server-only Razorpay webhook event deduplication log (denied to all client SDKs)."
    }
  }
}
