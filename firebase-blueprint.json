          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Recipient email for dispatch notifications.",
          "minLength": 5,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Recipient contact phone number.",
          "minLength": 7,
          "maxLength": 24
        },
        "shippingAddress": {
          "type": "string",
          "description": "Full street and warehouse delivery address.",
          "minLength": 5,
          "maxLength": 320
