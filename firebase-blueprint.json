          "description": "ISO-8601 timestamp when the dealer application was submitted.",
          "minLength": 10,
          "maxLength": 40
        },
        "approvalStatus": {
          "type": "string",
          "description": "Dealer onboarding verification state respected by both Admin Web and Mobile App.",
