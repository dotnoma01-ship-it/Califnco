          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "dealerId": {
          "type": "string",
          "description": "Mirrored dealer partner code read by the Flutter mobile DealerProfileModel.",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase UID of the dealer account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "description": "Registered wholesale entity name.",
          "minLength": 2,
          "maxLength": 140
        },
        "contactPerson": {
          "type": "string",
          "description": "Authorized trade applicant representative permitted for administrative review.",
          "minLength": 2,
          "maxLength": 100
        },
        "gstin": {
          "type": "string",
