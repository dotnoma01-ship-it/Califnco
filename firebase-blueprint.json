          "type": "string",
          "enum": ["INR"],
          "maxLength": 8
        },
        "status": {
          "type": "string",
          "enum": ["created", "paid", "failed"],
          "maxLength": 24
        },
        "createdAtIso": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": [
        "razorpayOrderId",
        "firestoreOrderId",
        "orderNumber",
        "customerUid",
        "amountPaise",
        "currency",
        "status",
        "createdAtIso"
      ]
    },
    "PaymentSettlementRecord": {
      "title": "PaymentSettlementRecord",
      "description": "Server-only idempotency ledger keyed by razorpayPaymentId preventing duplicate payment settlement across signature verification and webhooks.",
      "type": "object",
      "properties": {
        "razorpayPaymentId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "razorpayOrderId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "firestoreOrderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amountPaise": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["INR"],
          "maxLength": 8
        },
        "verifiedBy": {
          "type": "string",
          "enum": ["razorpay_signature_verify", "razorpay_webhook"],
          "maxLength": 40
        },
        "settledAtIso": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": [
        "razorpayPaymentId",
        "razorpayOrderId",
        "firestoreOrderId",
        "amountPaise",
        "currency",
        "verifiedBy",
        "settledAtIso"
      ]
    },
    "PaymentWebhookEventRecord": {
      "title": "PaymentWebhookEventRecord",
      "description": "Server-only webhook idempotency log keyed by x-razorpay-event-id preventing duplicate webhook processing.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventType": {
          "type": "string",
          "maxLength": 64
        },
        "razorpayOrderId": {
          "type": "string",
          "maxLength": 64
        },
        "razorpayPaymentId": {
          "type": "string",
          "maxLength": 64
        },
        "firestoreOrderId": {
          "type": "string",
          "maxLength": 128
        },
        "outcome": {
          "type": "string",
          "enum": ["settled", "already_settled", "payment_failed_recorded", "ignored"],
          "maxLength": 40
        },
        "processedAtIso": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
