          "maxLength": 20
        },
        "dispatchNotes": {
          "type": "string",
          "description": "Logistics or installation notes.",
          "minLength": 0,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "orderId",
        "recipientName",
        "email",
        "phone",
        "shippingAddress",
        "postalCode",
        "gstin",
        "dispatchNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "DealerSummary": {
      "title": "DealerSummary",
      "description": "Wholesale dealer application and approval record shared between the Admin Web Console and Flutter Dealer Mobile App without personal contact PII.",
      "type": "object",
      "properties": {
        "dealerCode": {
          "type": "string",
