{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator registry mapping Firebase Auth UIDs to administrative privileges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email address.",
          "minLength": 5,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "Full display name of the administrator.",
          "minLength": 1,
          "maxLength": 100
        },
        "grantedByUid": {
          "type": "string",
          "description": "UID of the administrator who granted access.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when administrator access was granted."
        }
      },
      "required": ["uid", "email", "displayName", "grantedByUid", "createdAt"]
    },
    "OrderSummary": {
      "title": "OrderSummary",
      "description": "Operational summary record for retail customer and wholesale dealer orders without sensitive shipping PII.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "description": "Human-readable order or PO reference code.",
          "minLength": 5,
          "maxLength": 40,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "channel": {
          "type": "string",
          "description": "Sales channel classification.",
          "enum": ["customer", "dealer"],
          "maxLength": 16
        },
        "customerUid": {
          "type": "string",
          "description": "Firebase UID of the purchasing customer or dealer account.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "partyId": {
          "type": "string",
          "description": "Customer or dealer account reference identifier.",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "partyDisplayName": {
          "type": "string",
          "description": "Display name or registered business name for order listing.",
          "minLength": 2,
          "maxLength": 120
        },
        "regionCity": {
          "type": "string",
          "description": "Destination city and state summary.",
          "minLength": 2,
          "maxLength": 80
        },
        "orderDateIso": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the order was placed.",
          "minLength": 10,
          "maxLength": 40
        },
        "itemCount": {
          "type": "number",
          "description": "Total unit count across all line items."
        },
        "subtotalAmount": {
          "type": "number",
          "description": "Order subtotal in INR before freight."
        },
        "deliveryAmount": {
          "type": "number",
          "description": "Delivery or freight charge in INR."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total payable order amount in INR."
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment settlement state. Client online checkouts initialize as razorpay_pending until verified server-side.",
          "enum": ["paid", "credit_net30", "cod_pending", "razorpay_pending", "refunded"],
          "maxLength": 24
        },
        "fulfilmentStatus": {
          "type": "string",
          "description": "Warehouse and logistics fulfilment lifecycle state.",
          "enum": ["pending", "confirmed", "processing", "dispatched", "delivered", "cancelled"],
          "maxLength": 24
        },
        "razorpayOrderId": {
          "type": "string",
          "description": "Server-generated Razorpay order identifier (order_*) bound by backend.",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "razorpayPaymentId": {
          "type": "string",
          "description": "Server-verified Razorpay payment identifier (pay_*) recorded only after HMAC/API capture verification.",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "paymentVerifiedSource": {
          "type": "string",
          "description": "Trusted server channel that verified payment capture.",
          "enum": ["razorpay_signature_verify", "razorpay_webhook", "admin_manual_settlement"],
          "maxLength": 40
        },
        "createdByUid": {
          "type": "string",
          "description": "UID of the actor that created the order record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest state transition."
        }
      },
      "required": [
        "orderNumber",
        "channel",
        "customerUid",
        "partyId",
        "partyDisplayName",
        "regionCity",
        "orderDateIso",
        "itemCount",
        "subtotalAmount",
        "deliveryAmount",
        "totalAmount",
        "paymentStatus",
        "fulfilmentStatus",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderLineItem": {
      "title": "OrderLineItem",
      "description": "Individual product SKU line item belonging to an order subcollection.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "description": "Parent order document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerUid": {
          "type": "string",
          "description": "Owner UID mirrored from parent order for O(1) query enforcement.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "description": "Product SKU identifier.",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "description": "Product title.",
          "minLength": 2,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Califnco hardware or consumable category.",
          "enum": ["Water Purifiers", "Dispensers", "Pumps", "Filters", "Spare Parts"],
          "maxLength": 32
        },
        "quantity": {
          "type": "number",
          "description": "Ordered unit count."
        },
        "unitPrice": {
          "type": "number",
          "description": "Unit price in INR."
        },
        "lineTotal": {
          "type": "number",
          "description": "Extended line total in INR."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "orderId",
        "customerUid",
        "sku",
        "productName",
        "category",
        "quantity",
        "unitPrice",
        "lineTotal",
        "createdAt"
      ]
    },
    "OrderPrivateDetails": {
      "title": "OrderPrivateDetails",
      "description": "Isolated PII subcollection storing sensitive recipient contact, street address, and tax details.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
