          "minLength": 15,
          "maxLength": 20,
          "pattern": "^[0-9A-Z]+$"
        },
        "businessType": {
          "type": "string",
          "description": "Wholesale channel classification.",
          "enum": [
            "Distributor",
            "Retail Franchise",
            "Commercial Integrator",
            "Service Franchise"
