        "reviewedByUid": {
          "type": "string",
          "description": "Firebase UID of the administrator who recorded the approval decision.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the approval or rejection decision was recorded."
        },
        "createdByUid": {
          "type": "string",
          "description": "UID of the creator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "dealerCode",
        "ownerUid",
        "businessName",
        "regionCity",
        "approvalStatus",
        "wholesaleTier",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
